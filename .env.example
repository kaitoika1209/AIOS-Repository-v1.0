# Copy to .env and fill in. Never commit .env.

# --- Database -----------------------------------------------------------
# PostgreSQL is the authoritative store (ADR-0006).
DATABASE_URL=postgresql://aios:aios@localhost:5432/aios

# --- Authentication (ADR-0013) ------------------------------------------
# Clerk authenticates only. It is not the source of truth for Organization,
# Membership, or roles, and Clerk Organizations are not enabled.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Verifies inbound Clerk webhooks, which may update profile fields only.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- AI provider (ADR-0016) ---------------------------------------------
# Memory generation is ExternalComputation (ADR-0004): no authoritative
# business effect, safe to retry.
#
# Unset in development: the deterministic generator runs instead, which
# invents nothing and needs no provider. Set this to use the real one.
ANTHROPIC_API_KEY=
# Overrides the model the generation policy pins. Changing it changes what
# provenance records, so prefer bumping the policy version instead.
ANTHROPIC_MODEL=

# --- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Liveness and readiness, on a listener separate from the application. It answers
# before authentication, so an orchestrator should reach it inside the network
# rather than through a public route. The Worker uses 3012.
PROBE_PORT=3011
WEB_ORIGIN=http://localhost:3000
# DEBUG | INFO | WARN | ERROR. Records are JSON on stdout, one per line
# (ADR-0003). Unset under NODE_ENV=test the logger is silent, so a suite does not
# bury its own output.
LOG_LEVEL=INFO
# Reported in every record's envelope, which requires the field.
SERVICE_VERSION=0.1.0

# --- Worker containment (ADR-0022) --------------------------------------
# Pauses a Worker type for EVERY Organization. There is no route and no
# permission for this, because the MVP models no principal with authority
# across Organizations — it is the deployment operator's control, and it takes
# effect on restart.
#
# A paused Worker reports readiness Unready with ADMINISTRATIVELY_PAUSED, and
# claims nothing: rows stay Pending and drain after the pause is lifted.
#
# To contain ONE Organization, do not use this. Use the routed commands
# (POST /admin/workers/{workerType}/pause), which are authorized by a
# Membership and cannot reach another tenant.
#
# Comma-separated. Valid names: OutboxPublication, MemoryGeneration.
WORKER_PAUSED_TYPES=
